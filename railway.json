{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "streamlit run app.py --server.port $PORT --server.address 0.0.0.0 --logger.level=error",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
